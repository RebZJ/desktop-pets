{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Pets",
  "version": "0.1.0",
  "identifier": "app.desktoppets.pace",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Desktop Pets",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "backgroundColor": "#faf8f3"
      },
      {
        "label": "pet",
        "title": "Pace",
        "url": "index.html?window=pet",
        "width": 180,
        "height": 200,
        "x": 1040,
        "y": 650,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "command",
        "title": "Ask Pace",
        "url": "index.html?window=command",
        "width": 620,
        "height": 440,
        "minWidth": 420,
        "minHeight": 300,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#faf8f3"
      },
      {
        "label": "bubble",
        "title": "Pace says",
        "url": "index.html?window=bubble",
        "width": 320,
        "height": 180,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "backgroundColor": "#faf8f3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {"enable": true, "scope": []}
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../native/bin/": "native/",
      "../native/lib/": "lib/",
      "../native/share/": "share/",
      "../native/licenses/": "licenses/"
    },
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A little desktop friend that helps you get things done.",
    "longDescription": "An open-source desktop pet with local chat, writing help, opt-in work memory, voice and meeting notes.",
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    }
  }
}

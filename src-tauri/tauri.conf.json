{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Pets",
  "version": "0.1.0",
  "identifier": "app.desktoppets.pace",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run native:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Desktop Pets",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#faf8f3",
        "contentProtected": true
      },
      {
        "label": "pet",
        "title": "Pace",
        "url": "index.html?window=pet",
        "width": 224,
        "height": 224,
        "x": 1040,
        "y": 650,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "contentProtected": true,
        "focusable": false,
        "acceptFirstMouse": true
      },
      {
        "label": "command",
        "title": "Write for me",
        "url": "index.html?window=command",
        "width": 360,
        "height": 200,
        "minWidth": 300,
        "minHeight": 180,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "shadow": false,
        "transparent": true,
        "contentProtected": true,
        "acceptFirstMouse": true,
        "focus": false
      },
      {
        "label": "bubble",
        "title": "Pace says",
        "url": "index.html?window=bubble",
        "width": 300,
        "height": 200,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "backgroundColor": "#00000000",
        "shadow": false,
        "transparent": true,
        "contentProtected": true,
        "acceptFirstMouse": true
      },
      {
        "label": "meeting",
        "title": "Meeting with Pace",
        "url": "index.html?window=meeting",
        "width": 420,
        "height": 380,
        "minWidth": 360,
        "minHeight": 300,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "backgroundColor": "#00000000",
        "shadow": false,
        "transparent": true,
        "contentProtected": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../native/bin/": "native/",
      "../native/lib/": "lib/",
      "../native/share/": "share/",
      "../native/licenses/": "licenses/"
    },
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local dictation, meeting notes and meeting questions.",
    "longDescription": "An open-source desktop companion with local dictation, speaker-labeled meeting notes and questions grounded in the current meeting.",
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    }
  }
}

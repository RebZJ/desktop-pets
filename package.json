{
  "name": "desktop-pets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local desktop companion for dictation, speaker-labeled meeting notes and meeting questions.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "npm run dev",
    "native:build": "node native/scripts/build-native.mjs",
    "native:diarization": "node native/scripts/build-native.mjs --diarization",
    "native:test": "npm run test:rust",
    "native:test:inference": "cargo test --manifest-path src-tauri/Cargo.toml portable::tests::actual_portable_qwen_answers_from_supplied_meeting_source --lib -- --ignored",
    "test": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "check": "npm run build && npm run test:rust && npm test",
    "dev:web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.8"
  }
}
